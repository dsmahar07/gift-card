# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"
CLERK_WEBHOOK_SECRET="whsec_xxxxx"

# Payment Gateway - NowPayments
NOWPAYMENTS_API_KEY="your_nowpayments_api_key"
NOWPAYMENTS_IPN_SECRET="your_ipn_secret"

# Reloadly (Gift Card Provider)
RELOADLY_CLIENT_ID="your_reloadly_client_id"
RELOADLY_CLIENT_SECRET="your_reloadly_client_secret"

# Email Service - Resend
RESEND_API_KEY="re_xxxxx"

# Encryption
ENCRYPTION_KEY="your_32_character_encryption_key_here"

# Application URLs
NEXT_PUBLIC_APP_URL="https://giftswap.shop"
NEXT_PUBLIC_API_URL="https://giftswap.shop/api"

# Admin Email
ADMIN_EMAIL="admin@giftswap.shop"

# Node Environment
NODE_ENV="production"
